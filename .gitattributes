# Set default behavior to LF
* text=auto eol=lf

# Explicitly set LF for source files
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf

# Scripts
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# CMake files
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Other text files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Binary files
*.exe -text
*.obj -text
*.lib -text
*.dll -text
*.pdb -text

